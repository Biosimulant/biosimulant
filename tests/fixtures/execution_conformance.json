        "b": "each_window"
      },
      "expected": {
        "timing": "temporal",
        "undeclared": []
      }
    },
    {
      "policies": {
        "a": null,
        "b": "each_window"
      },
      "expected": {
        "timing": "temporal",
        "undeclared": [
          "a"
        ]
      }
    },
    {
