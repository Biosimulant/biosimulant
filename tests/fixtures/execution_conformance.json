          ]
        },
        {
          "from": "right.b",
          "to": [
            "left.b"
          ]
        }
      ],
      "expected_findings": [
        "once_after_run modules contain a dependency cycle: left, right"
      ]
    },
    {
      "policies": {
        "left": "each_window",
        "right": "each_window"
      },
      "wiring": [
        {
          "from": "left.a",
          "to": [
            "right.a"
          ]
        },
        {
          "from": "right.b",
          "to": [
            "left.b"
          ]
        }
      ],
      "expected_findings": []
    },
    {
      "policies": {
        "sim": "each_window",
        "prep": null
      },
      "wiring": [
        {
          "from": "sim.out",
          "to": [
            "prep.x"
          ]
        }
      ],
      "expected_findings": []
    },
    {
      "policies": {
        "child.prep": "once_after_run",
